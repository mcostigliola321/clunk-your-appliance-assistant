{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clunk.example/schemas/repair-pack.schema.json",
  "title": "Clunk repair pack",
  "description": "A source-backed, static appliance repair pack used by Clunk's deterministic engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "modelId",
    "schemaVersion",
    "appliance",
    "symptom",
    "productCodePrompt",
    "verifiedProductCodes",
    "components",
    "checks",
    "causes",
    "parts",
    "sources",
    "example"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/repairPackIdentifier" },
    "modelId": { "$ref": "#/$defs/identifier" },
    "schemaVersion": { "const": 6 },
    "appliance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "kindLabel",
        "noun",
        "brand",
        "model",
        "type",
        "capability",
        "topology",
        "illustration",
        "diagramNote"
      ],
      "properties": {
        "kind": { "enum": ["washer", "dishwasher", "dryer", "refrigerator"] },
        "kindLabel": { "$ref": "#/$defs/shortText" },
        "noun": { "$ref": "#/$defs/shortText" },
        "brand": {
          "enum": [
            "LG",
            "Samsung",
            "GE",
            "Hotpoint",
            "Whirlpool",
            "Maytag",
            "Amana",
            "Electrolux",
            "Frigidaire",
            "Bosch",
            "KitchenAid"
          ]
        },
        "model": { "$ref": "#/$defs/shortText" },
        "type": { "$ref": "#/$defs/shortText" },
        "capability": {
          "enum": ["purchase-ready", "guided-checks", "verified-part-unavailable"]
        },
        "loadStyle": { "enum": ["front-load", "top-load"] },
        "topology": { "$ref": "#/$defs/shortText" },
        "illustration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "width", "height", "alt"],
          "properties": {
            "src": { "type": "string", "pattern": "^/assets/" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "alt": { "$ref": "#/$defs/shortText" }
          }
        },
        "diagramNote": { "$ref": "#/$defs/bodyText" }
      }
    },
    "symptom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "shortLabel"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/shortText" },
        "shortLabel": { "$ref": "#/$defs/shortText" }
      }
    },
    "productCodePrompt": { "$ref": "#/$defs/bodyText" },
    "verifiedProductCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 80 }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description", "access", "hotspot"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "$ref": "#/$defs/shortText" },
          "description": { "$ref": "#/$defs/bodyText" },
          "access": { "enum": ["visible", "user-accessible", "professional-only"] },
          "hotspot": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 100 },
              "y": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "componentId",
          "instruction",
          "why",
          "stop",
          "safetyTags",
          "sourceIds",
          "results"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "$ref": "#/$defs/shortText" },
          "componentId": { "$ref": "#/$defs/identifier" },
          "instruction": { "$ref": "#/$defs/bodyText" },
          "why": { "$ref": "#/$defs/bodyText" },
          "stop": { "$ref": "#/$defs/bodyText" },
          "safetyTags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "disconnect-power",
                "cool-water",
                "external-observation",
                "no-disassembly",
                "spill-control",
                "user-accessible-filter",
                "user-replaceable-filter",
                "visible-door-hardware",
                "sink-check"
              ]
            }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "results": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "effect"],
              "properties": {
                "id": { "$ref": "#/$defs/identifier" },
                "label": { "$ref": "#/$defs/shortText" },
                "effect": {
                  "enum": [
                    "continue",
                    "no-part-needed",
                    "part-candidate",
                    "professional-only",
                    "hazard"
                  ]
                },
                "nextCheckId": { "$ref": "#/$defs/identifier" },
                "focusComponentId": { "$ref": "#/$defs/identifier" },
                "escalationReason": {
                  "enum": [
                    "electrical",
                    "burning-smell",
                    "hot-water",
                    "active-leak",
                    "internal-access",
                    "unresolved"
                  ]
                },
                "outcomeTitle": { "$ref": "#/$defs/shortText" },
                "outcomeMessage": { "$ref": "#/$defs/bodyText" }
              }
            }
          }
        }
      }
    },
    "causes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "componentId", "baseRank", "defaultExplanation"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "$ref": "#/$defs/shortText" },
          "componentId": { "$ref": "#/$defs/identifier" },
          "baseRank": { "type": "integer", "minimum": 0, "maximum": 100 },
          "defaultExplanation": { "$ref": "#/$defs/bodyText" },
          "resultScores": { "type": "object", "additionalProperties": { "type": "number" } },
          "resultExplanations": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/bodyText" }
          }
        }
      }
    },
    "parts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/part" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    },
    "example": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "summary", "productCode", "observations"],
          "properties": {
            "title": { "$ref": "#/$defs/shortText" },
            "summary": { "$ref": "#/$defs/shortText" },
            "productCode": { "$ref": "#/$defs/shortText" },
            "observations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["checkId", "resultId"],
                "properties": {
                  "checkId": { "$ref": "#/$defs/identifier" },
                  "resultId": { "$ref": "#/$defs/identifier" }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "repairPackIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*::[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 160
    },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 140 },
    "bodyText": { "type": "string", "minLength": 1, "maxLength": 700 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "url", "publisher", "appliesTo", "lastVerified"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": [
            "manufacturer-model",
            "manufacturer-troubleshooting",
            "manufacturer-part",
            "authorized-parts"
          ]
        },
        "title": { "$ref": "#/$defs/shortText" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publisher": { "$ref": "#/$defs/shortText" },
        "appliesTo": { "$ref": "#/$defs/shortText" },
        "lastVerified": { "type": "string", "format": "date" }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "componentId",
        "name",
        "sku",
        "compatibleProductCodes",
        "compatibleModel",
        "installBoundary",
        "source"
      ],
      "anyOf": [{ "required": ["purchase"] }, { "required": ["commerce"] }],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "componentId": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/shortText" },
        "sku": { "type": "string", "pattern": "^[A-Za-z0-9-]{3,40}$" },
        "compatibleProductCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "compatibleModel": { "$ref": "#/$defs/shortText" },
        "location": { "$ref": "#/$defs/shortText" },
        "installBoundary": { "enum": ["user-replaceable", "professional-only"] },
        "source": { "$ref": "#/$defs/source" },
        "commerce": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "protocol",
            "query",
            "exactSku",
            "offerCountAtVerification",
            "lastVerified"
          ],
          "properties": {
            "provider": { "const": "shopify-global-catalog" },
            "protocol": { "const": "UCP" },
            "query": { "$ref": "#/$defs/bodyText" },
            "exactSku": { "type": "string", "pattern": "^[A-Za-z0-9-]{3,40}$" },
            "offerCountAtVerification": { "type": "integer", "minimum": 0 },
            "lastVerified": { "type": "string", "format": "date" }
          }
        },
        "purchase": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seller",
            "url",
            "priceAtVerification",
            "availabilityAtVerification",
            "lastVerified"
          ],
          "properties": {
            "seller": { "$ref": "#/$defs/shortText" },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "priceAtVerification": { "$ref": "#/$defs/shortText" },
            "availabilityAtVerification": { "$ref": "#/$defs/shortText" },
            "lastVerified": { "type": "string", "format": "date" }
          }
        }
      }
    }
  }
}
