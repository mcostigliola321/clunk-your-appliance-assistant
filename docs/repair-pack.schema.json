{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clunk.example/schemas/repair-pack.schema.json",
  "title": "Clunk repair pack",
  "description": "Static fictional appliance data used by a deterministic Clunk diagnosis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "appliance",
    "symptom",
    "components",
    "checks",
    "causes",
    "parts"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "schemaVersion": { "const": 1 },
    "appliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "type", "fictional"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "model": { "type": "string", "minLength": 1, "maxLength": 60 },
        "type": { "type": "string", "minLength": 1, "maxLength": 80 },
        "fictional": { "const": true }
      }
    },
    "symptom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/shortText" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "$ref": "#/$defs/shortText" },
          "description": { "$ref": "#/$defs/bodyText" }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "componentId",
          "instruction",
          "why",
          "stop",
          "safetyTags",
          "results"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "$ref": "#/$defs/shortText" },
          "componentId": { "$ref": "#/$defs/identifier" },
          "instruction": { "$ref": "#/$defs/bodyText" },
          "why": { "$ref": "#/$defs/bodyText" },
          "stop": { "$ref": "#/$defs/bodyText" },
          "safetyTags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "power-disconnected",
                "external-observation",
                "water-release",
                "user-access-door"
              ]
            }
          },
          "results": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "$ref": "#/$defs/identifier" },
                "label": { "$ref": "#/$defs/shortText" }
              }
            }
          }
        }
      }
    },
    "causes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "componentId", "baseRank"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "$ref": "#/$defs/shortText" },
          "componentId": { "$ref": "#/$defs/identifier" },
          "baseRank": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "componentId",
          "name",
          "sku",
          "compatibleModel",
          "effort",
          "illustrativeCost",
          "installBoundary"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "componentId": { "$ref": "#/$defs/identifier" },
          "name": { "$ref": "#/$defs/shortText" },
          "sku": { "type": "string", "pattern": "^[A-Z0-9-]{3,32}$" },
          "compatibleModel": { "$ref": "#/$defs/shortText" },
          "effort": { "$ref": "#/$defs/shortText" },
          "illustrativeCost": { "enum": ["Low", "Medium", "High"] },
          "installBoundary": { "enum": ["user-cleanable", "professional-only"] }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 120 },
    "bodyText": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
