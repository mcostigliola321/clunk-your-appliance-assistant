{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clunk.example/schemas/repair-pack.schema.json",
  "title": "Clunk repair pack",
  "description": "A source-backed, static appliance repair pack used by Clunk's deterministic engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "appliance",
    "symptom",
    "productCodePrompt",
    "verifiedProductCodes",
    "components",
    "checks",
    "causes",
    "parts",
    "sources"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/identifier" },
    "schemaVersion": { "const": 2 },
    "appliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "model", "type", "topology"],
      "properties": {
        "brand": {
          "enum": ["LG", "Samsung", "GE", "Whirlpool", "Maytag", "Electrolux"]
        },
        "model": { "$ref": "#/$defs/shortText" },
        "type": { "const": "front-load washer" },
        "topology": { "enum": ["front-filter", "drawer-filter", "hose-only"] }
      }
    },
    "symptom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "const": "will-not-drain" },
        "label": { "$ref": "#/$defs/shortText" }
      }
    },
    "productCodePrompt": { "$ref": "#/$defs/bodyText" },
    "verifiedProductCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 80 }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description", "access"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "$ref": "#/$defs/shortText" },
          "description": { "$ref": "#/$defs/bodyText" },
          "access": { "enum": ["visible", "user-accessible", "professional-only"] }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "componentId",
          "instruction",
          "why",
          "stop",
          "safetyTags",
          "sourceIds",
          "results"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "$ref": "#/$defs/shortText" },
          "componentId": { "$ref": "#/$defs/identifier" },
          "instruction": { "$ref": "#/$defs/bodyText" },
          "why": { "$ref": "#/$defs/bodyText" },
          "stop": { "$ref": "#/$defs/bodyText" },
          "safetyTags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "disconnect-power",
                "cool-water",
                "external-observation",
                "no-disassembly",
                "spill-control",
                "user-accessible-filter"
              ]
            }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "results": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "$ref": "#/$defs/identifier" },
                "label": { "$ref": "#/$defs/shortText" }
              }
            }
          }
        }
      }
    },
    "causes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "componentId", "baseRank"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "$ref": "#/$defs/shortText" },
          "componentId": { "$ref": "#/$defs/identifier" },
          "baseRank": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    },
    "parts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/part" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 140 },
    "bodyText": { "type": "string", "minLength": 1, "maxLength": 700 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "url", "publisher", "appliesTo", "lastVerified"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": [
            "manufacturer-model",
            "manufacturer-troubleshooting",
            "manufacturer-part",
            "authorized-parts"
          ]
        },
        "title": { "$ref": "#/$defs/shortText" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publisher": { "$ref": "#/$defs/shortText" },
        "appliesTo": { "$ref": "#/$defs/shortText" },
        "lastVerified": { "type": "string", "format": "date" }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "componentId",
        "name",
        "sku",
        "compatibleProductCodes",
        "compatibleModel",
        "installBoundary",
        "source"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "componentId": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/shortText" },
        "sku": { "type": "string", "pattern": "^[A-Za-z0-9-]{3,40}$" },
        "compatibleProductCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "compatibleModel": { "$ref": "#/$defs/shortText" },
        "installBoundary": { "const": "professional-only" },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
