{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clunk.example/schemas/catalog-expansion.schema.json",
  "title": "Clunk guided catalog expansion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "retrievedOn", "profiles", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "retrievedOn": { "type": "string", "format": "date" },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "publisher", "appliesTo"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publisher": { "type": "string", "minLength": 1 },
        "appliesTo": { "type": "string", "minLength": 1 }
      }
    },
    "exactPartSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "url", "publisher", "appliesTo"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["manufacturer-part", "authorized-parts"] },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publisher": { "type": "string", "minLength": 1 },
        "appliesTo": { "type": "string", "minLength": 2 }
      }
    },
    "commerceAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "exactSku", "offerCountAtVerification"],
      "properties": {
        "query": { "type": "string", "minLength": 2 },
        "exactSku": { "type": "string", "minLength": 2 },
        "offerCountAtVerification": { "type": "integer", "minimum": 1 }
      }
    },
    "exactPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "componentId",
        "name",
        "sku",
        "compatibleProductCodes",
        "compatibleModel",
        "installBoundary",
        "source",
        "commerce"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sku": { "type": "string", "minLength": 2 },
        "compatibleProductCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "compatibleModel": { "type": "string", "minLength": 2 },
        "location": { "type": "string", "minLength": 1 },
        "installBoundary": { "enum": ["user-replaceable", "professional-only"] },
        "source": { "$ref": "#/$defs/exactPartSource" },
        "commerce": { "$ref": "#/$defs/commerceAudit" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand",
        "kind",
        "label",
        "productCodePrompt",
        "topology",
        "profile",
        "supportedSymptom",
        "troubleshootingSources"
      ],
      "properties": {
        "brand": {
          "enum": [
            "LG",
            "Samsung",
            "GE",
            "Hotpoint",
            "Whirlpool",
            "Maytag",
            "Amana",
            "Electrolux",
            "Frigidaire",
            "Bosch",
            "KitchenAid"
          ]
        },
        "kind": { "enum": ["washer", "dishwasher", "dryer", "refrigerator"] },
        "label": { "type": "string", "minLength": 1 },
        "productCodePrompt": { "type": "string", "minLength": 1 },
        "topology": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "supportedSymptom": {
          "enum": ["will-not-drain", "door-will-not-close", "slow-water-flow"]
        },
        "loadStyle": { "enum": ["front-load", "top-load"] },
        "checkProfile": {
          "enum": ["filter-access", "hose-then-service", "sink-then-service"]
        },
        "troubleshootingSources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "model", "aliases", "verifiedProductCodes", "officialUrl"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "profile": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 2 },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "verifiedProductCodes": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 }
        },
        "retrievedOn": { "type": "string", "format": "date" },
        "officialUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "exactPart": { "$ref": "#/$defs/exactPart" }
      }
    }
  }
}
