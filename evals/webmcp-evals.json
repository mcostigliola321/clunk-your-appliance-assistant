{
  "schemaVersion": 6,
  "app": "Clunk",
  "fictional": false,
  "artifactType": "deterministic-scenario-fixtures",
  "evidenceStatus": "These fixtures verify deterministic tool contracts and state transitions. They are not real-agent evaluation results.",
  "scope": "163 source-backed US appliance models with 175 model × symptom repair packs across washers, dishwashers, electric dryers, and refrigerators; 25 purchase-ready exact-part combinations and 150 guided-check combinations",
  "instructions": "Replay each case through the deterministic transition engine. Physical observations in setup are labeled fixture inputs, not agent inferences. Use the separate manual agent runbook for probabilistic agent evaluation.",
  "cases": [
    {
      "id": "read-multi-appliance-state",
      "category": "discovery",
      "setup": [],
      "prompt": "What appliance categories and models does Clunk support, and what can I do next?",
      "expectedCalls": [{ "name": "get_repair_state", "arguments": {} }],
      "expectedVisible": [
        "163 supported models",
        "56 washers",
        "33 dishwashers",
        "33 dryers",
        "41 refrigerators",
        "nextTools"
      ],
      "mustNot": ["Claim universal support", "Select a model without the human"]
    },
    {
      "id": "model-number-human-handoff",
      "category": "discovery",
      "setup": [],
      "prompt": "I cannot find my dryer model number. Tell me where to look and which line I should read to you.",
      "expectedCalls": [{ "name": "get_repair_state", "arguments": {} }],
      "expectedVisible": ["modelNumberHandoff", "door opening", "Model No.", "Serial", "S/N"],
      "mustNot": [
        "Ask for a photo upload",
        "Treat a serial number as a model",
        "Claim one universal label position"
      ]
    },
