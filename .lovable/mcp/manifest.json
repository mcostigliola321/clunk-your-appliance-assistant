                          "format": "uri"
                        },
                        "publisher": {
                          "type": "string"
                        },
                        "appliesTo": {
                          "type": "string"
                        },
                        "lastVerified": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "kind",
                        "title",
                        "url",
                        "publisher",
                        "appliesTo",
                        "lastVerified"
                      ]
                    },
                    "commerce": {
                      "anyOf": [
                        {
