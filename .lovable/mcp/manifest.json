                                "manufacturer-part",
                                "authorized-parts"
                              ]
                            },
                            "title": {
                              "type": "string"
                            },
                            "url": {
                              "type": "string",
                              "format": "uri"
                            },
                            "publisher": {
                              "type": "string"
                            },
                            "appliesTo": {
                              "type": "string"
                            },
                            "lastVerified": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "kind",
                            "title",
                            "url",
                            "publisher",
                            "appliesTo",
                            "lastVerified"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "title",
                    "message",
                    "requiredProductCode",
                    "source"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "part": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "sku": {
                      "type": "string"
                    },
                    "compatibleModel": {
                      "type": "string"
                    },
                    "location": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "installBoundary": {
                      "type": "string",
                      "enum": [
                        "user-replaceable",
                        "professional-only"
                      ]
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "manufacturer-model",
                            "manufacturer-troubleshooting",
                            "manufacturer-part",
                            "authorized-parts"
                          ]
                        },
                        "title": {
                          "type": "string"
                        },
                        "url": {
