      {
        "name": "run_diagnosis",
        "title": "Run diagnosis",
        "description": "Replay a person's reported observations through Clunk's deterministic repair engine and return the outcome: no part needed, an exact source-backed part, a request for the complete model code, or a professional-service stop. Only pass results the person actually observed.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "applianceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Catalog ID returned by search_appliances."
            },
            "symptomId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Observable problem ID covered for that model."
            },
            "productCode": {
              "description": "The complete model code the person read from the rating label. Required for an exact-part answer.",
              "type": "string",
              "maxLength": 64
            },
            "observations": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "checkId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "description": "Check ID from get_repair_guide."
                  },
                  "resultId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "description": "Result ID the person observed for that check."
                  }
                },
                "required": [
                  "checkId",
                  "resultId"
                ]
              },
              "description": "Ordered observations, starting with the guide's first check."
            }
          },
          "required": [
            "applianceId",
            "symptomId",
            "observations"
          ]
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "enum": [
                "catalog",
                "idle",
                "preparing",
                "checking",
                "result",
                "escalated"
              ]
            },
            "summary": {
              "type": "string"
            },
            "transcript": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tool": {
                    "type": "string",
                    "enum": [
                      "search_supported_appliances",
                      "select_appliance",
                      "get_repair_state",
                      "start_diagnosis",
                      "show_component",
                      "record_observation",
                      "find_compatible_part",
                      "stop_and_escalate"
                    ]
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "tool",
                  "ok",
                  "message"
                ]
              }
            },
            "nextCheck": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "instruction": {
                      "type": "string"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "label"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "instruction",
                    "results"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "outcome": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "not-ready",
                        "no-part-needed",
                        "exact",
                        "variant-needed",
                        "professional-only"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requiredProductCode": {
                      "type": [
                        "string",
