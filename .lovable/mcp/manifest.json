{
  "version": 1,
  "sdk_version": "1.0.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "clunk-your-appliance-assistant",
      "version": "0.1.0",
      "title": "Clunk: Your Appliance Assistant"
    },
    "tools": [
      {
        "name": "search_appliances",
        "title": "Search supported appliances",
        "description": "Search Clunk's bounded catalog of source-backed U.S. appliance models by model text, category, or brand. Returns catalog IDs, verified model codes, and per-problem capability. Never guesses a nearest model.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Model text from the appliance rating label, e.g. 'WM3400CW' or 'GTD42EASJ2WW'.",
              "type": "string",
              "maxLength": 64
            },
            "kind": {
              "description": "Restrict results to one appliance category.",
              "type": "string",
              "enum": [
                "washer",
                "dishwasher",
                "dryer",
                "refrigerator"
              ]
            },
            "brand": {
              "description": "Restrict results to one brand name.",
              "type": "string",
              "maxLength": 40
            },
            "symptomId": {
              "description": "Only return models that Clunk covers for this observable problem.",
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "guidance": {
              "type": "string"
            },
            "matchCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "applianceId": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "washer",
                      "dishwasher",
                      "dryer",
                      "refrigerator"
                    ]
                  },
                  "brand": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "verifiedProductCodes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "productCodePrompt": {
                    "type": "string"
                  },
                  "coverage": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "symptomId": {
                          "type": "string"
                        },
                        "capability": {
                          "type": "string",
                          "enum": [
                            "purchase-ready",
                            "guided-checks",
                            "verified-part-unavailable"
                          ]
                        },
                        "capabilityLabel": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "symptomId",
                        "capability",
                        "capabilityLabel"
                      ]
                    }
                  }
                },
                "required": [
                  "applianceId",
                  "kind",
                  "brand",
                  "model",
                  "label",
                  "verifiedProductCodes",
                  "productCodePrompt",
                  "coverage"
                ]
              }
            }
          },
          "required": [
            "status",
            "guidance",
            "matchCount",
            "results"
          ]
        }
      },
      {
        "name": "get_appliance_coverage",
        "title": "Get appliance coverage",
        "description": "List every observable problem Clunk covers for one catalog model, with its capability (exact part available, safe checks available, or exact part currently unavailable) and the model source reference.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "applianceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Catalog ID returned by search_appliances."
            }
          },
          "required": [
            "applianceId"
          ]
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "applianceId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "washer",
                "dishwasher",
                "dryer",
                "refrigerator"
              ]
            },
            "brand": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "verifiedProductCodes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "productCodePrompt": {
              "type": "string"
            },
            "modelSource": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "manufacturer-model",
                    "manufacturer-troubleshooting",
                    "manufacturer-part",
                    "authorized-parts"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "publisher": {
                  "type": "string"
                },
                "appliesTo": {
                  "type": "string"
                },
                "lastVerified": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "kind",
                "title",
                "url",
                "publisher",
                "appliesTo",
                "lastVerified"
              ]
            },
            "coverage": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "symptomId": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "capability": {
                    "type": "string",
                    "enum": [
                      "purchase-ready",
                      "guided-checks",
                      "verified-part-unavailable"
                    ]
                  },
                  "capabilityLabel": {
                    "type": "string"
                  }
                },
                "required": [
                  "symptomId",
                  "title",
                  "description",
                  "capability",
                  "capabilityLabel"
                ]
              }
            }
          },
          "required": [
            "applianceId",
            "kind",
            "brand",
            "model",
            "label",
            "verifiedProductCodes",
            "productCodePrompt",
            "modelSource",
            "coverage"
          ]
        }
      },
      {
        "name": "get_repair_guide",
        "title": "Get repair guide",
        "description": "Return the deterministic, source-backed guide for one model and problem: the ordered safe checks a person can perform, the possible results of each check, the visible components, and the official source references. Physical observation always stays with the person.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "applianceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Catalog ID returned by search_appliances."
            },
            "symptomId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Observable problem ID returned by get_appliance_coverage."
            }
          },
          "required": [
            "applianceId",
            "symptomId"
          ]
        },
        "outputSchema": {
